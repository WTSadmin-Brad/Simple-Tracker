rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // HELPER FUNCTIONS
    // ===========================

    // --- Authentication & Roles ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      // Assumes role is stored in Firebase Auth custom claims
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Timestamps ---
    function isValidTimestamp(timestamp) {
      return timestamp is timestamp;
    }

    function isTimestampInFuture(timestamp) {
      return timestamp > request.time;
    }

    function isTimestampNotTooFarInFuture(timestamp, days) {
      let maxDuration = duration.value(days * 24 * 60 * 60, 's'); // Convert days to seconds duration
      return timestamp <= request.time + maxDuration;
    }

    // --- Field Validation ---
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function isNotChanging(field) {
      // Check if a specific field is being changed during an update
      return request.resource.data[field] == resource.data[field];
    }

    function isMap(value) {
      return value is map;
    }

    function isString(value) {
      return value is string;
    }

    function isNumber(value) {
      return value is number;
    }

     function isBoolean(value) {
      return value is bool;
    }

    function isArray(value) {
      return value is list;
    }

    // --- Enum Validation ---
    function isValidUserRole(role) {
      return role == 'admin' || role == 'employee';
    }

    function isValidUserStatus(status) {
      return status == 'active' || status == 'inactive' || status == 'pending';
    }

     function isValidJobsiteStatus(status) {
      return status == 'active' || status == 'inactive' || status == 'completed';
    }

     function isValidTruckStatus(status) {
      return status == 'active' || status == 'inactive' || status == 'maintenance';
    }

    function isValidWorkdayType(type) {
      return type == 'regular' || type == 'overtime' || type == 'holiday' || type == 'sick' || type == 'vacation';
    }

     function isValidWorkdayStatus(status) {
      return status == 'active' || status == 'archived';
    }

    function isValidTicketArchiveStatus(status) {
      return status == 'active' || status == 'images_archived' || status == 'fully_archived';
    }

    function isValidExportType(type) {
      return type == 'tickets' || type == 'workdays';
    }

    function isValidExportFormat(format) {
      return format == 'csv' || format == 'excel' || format == 'json';
    }

    function isValidExportStatus(status) {
      return status == 'completed' || status == 'processing' || status == 'error';
    }

    function isValidArchiveType(type) {
      return type == 'ticket' || type == 'workday' || type == 'image';
    }

     function isValidArchiveStatus(status) {
      return status == 'archived' || status == 'restored';
    }

    // --- Ticket Specific Validation ---
    function isValidTicketCategories(categories) {
      return categories is map &&
             categories.keys().size() > 0 && // Must have at least one category
             categories.values().forall(count, count is number && count >= 0 && count <= 999); // Example count limits
    }

    function isValidTicketTotal(categories, total) {
       // Total is optional in schema, but if provided, it must match the sum
       return total == null || (total is number && total == categories.values().sum());
    }

    function isValidImageCount(imageUrls, imageCount) {
      // imageCount is optional, but if provided, must match array size
      return imageCount == null || (imageCount is number && imageCount == imageUrls.size());
    }

    // ===========================
    // COLLECTION RULES
    // ===========================

    // --- Users Collection (`users`) ---
    match /users/{userId} {
      // Read: Any authenticated user can read profiles (adjust if more privacy needed)
      allow read: if isAuthenticated();

      // Create: Only admins can create users. Validate required fields and enums.
      allow create: if isAdmin() &&
                       hasRequiredFields(request.resource.data, ['email', 'displayName', 'role', 'createdAt']) &&
                       isString(request.resource.data.email) && // Basic type checks
                       isString(request.resource.data.displayName) &&
                       isValidUserRole(request.resource.data.role) &&
                       isValidTimestamp(request.resource.data.createdAt) &&
                       // Optional field validation
                       (request.resource.data.containsKey('status') ? isValidUserStatus(request.resource.data.status) : true) &&
                       (request.resource.data.containsKey('isActive') ? isBoolean(request.resource.data.isActive) : true);


      // Update: Admins can update anything. Owners can update specific fields.
      allow update: if isAdmin() ||
                       (isOwner(userId) &&
                        isNotChanging('role') && // Prevent owner changing critical fields
                        isNotChanging('email') &&
                        isNotChanging('status') &&
                        isNotChanging('isActive') &&
                        isNotChanging('uid') &&
                        isNotChanging('createdAt') &&
                        // Validate optional fields if they are being updated
                        (request.resource.data.containsKey('status') ? isValidUserStatus(request.resource.data.status) : true) &&
                        (request.resource.data.containsKey('animationPrefs') ? isMap(request.resource.data.animationPrefs) : true) &&
                        isValidTimestamp(request.resource.data.updatedAt)); // Ensure updatedAt is valid

      // Delete: Only admins can delete users.
      allow delete: if isAdmin();
    }

    // --- Jobsites Collection (`jobsites`) ---
    match /jobsites/{jobsiteId} {
      // Read: All authenticated users can read.
      allow read: if isAuthenticated();

      // Create: Only admins can create. Validate required fields and enums.
      allow create: if isAdmin() &&
                       hasRequiredFields(request.resource.data, ['name', 'location', 'status', 'client', 'createdAt']) &&
                       isString(request.resource.data.name) &&
                       (isString(request.resource.data.location) /* || isGeoPoint(request.resource.data.location) */) && // Add GeoPoint check if used
                       isValidJobsiteStatus(request.resource.data.status) &&
                       isString(request.resource.data.client) &&
                       isValidTimestamp(request.resource.data.createdAt);

      // Update: Only admins can update. Validate fields.
      allow update: if isAdmin() &&
                       isValidJobsiteStatus(request.resource.data.status) && // Validate status on update
                       isValidTimestamp(request.resource.data.updatedAt);

      // Delete: Only admins can delete.
      allow delete: if isAdmin();
    }

    // --- Trucks Collection (`trucks`) ---
    match /trucks/{truckId} {
      // Read: All authenticated users can read.
      allow read: if isAuthenticated();

      // Create: Only admins can create. Validate required fields and enums.
      allow create: if isAdmin() &&
                       hasRequiredFields(request.resource.data, ['truckNumber', 'nickname', 'status', 'createdAt']) &&
                       isString(request.resource.data.truckNumber) &&
                       isString(request.resource.data.nickname) &&
                       isValidTruckStatus(request.resource.data.status) &&
                       isValidTimestamp(request.resource.data.createdAt);

      // Update: Only admins can update. Validate fields.
      allow update: if isAdmin() &&
                       isValidTruckStatus(request.resource.data.status) && // Validate status on update
                       isValidTimestamp(request.resource.data.updatedAt);

      // Delete: Only admins can delete.
      allow delete: if isAdmin();
    }

    // --- Workdays Collection (`workdays`) ---
    match /workdays/{workdayId} {
      // Read: All authenticated users can read (filter on client-side).
      // Read: Admins can read all, owners can read their own.
      allow read: if isAdmin() || isOwner(resource.data.userId);

      // Create: Authenticated user can create their own workday. Validate required fields, ownership, and enums.
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid && // Must be owner
                       hasRequiredFields(request.resource.data, ['userId', 'date', 'jobsite', 'workType', 'hours', 'status', 'createdAt']) &&
                       isValidTimestamp(request.resource.data.date) &&
                       isString(request.resource.data.jobsite) &&
                       isValidWorkdayType(request.resource.data.workType) &&
                       isNumber(request.resource.data.hours) && request.resource.data.hours > 0 && request.resource.data.hours <= 24 && // Example hour validation
                       isValidWorkdayStatus(request.resource.data.status) &&
                       isValidTimestamp(request.resource.data.createdAt);

      // Update: Admin or owner can update. Owner cannot change userId. Validate fields.
      allow update: if isAdmin() ||
                       (isOwner(resource.data.userId) && // Check ownership based on existing doc
                        isNotChanging('userId') && // Owner cannot change userId
                        isNotChanging('createdAt') && // Cannot change createdAt
                        isValidWorkdayType(request.resource.data.workType) && // Validate fields on update
                        isNumber(request.resource.data.hours) && request.resource.data.hours > 0 && request.resource.data.hours <= 24 &&
                        isValidWorkdayStatus(request.resource.data.status) &&
                        isValidTimestamp(request.resource.data.updatedAt));

      // Delete: Only admins can delete.
      allow delete: if isAdmin();
    }

    // --- Tickets Collection (`tickets`) ---
    match /tickets/{ticketId} {
      // Read: All authenticated users can read (filter on client-side).
      // Read: Admins can read all, owners can read their own.
      allow read: if isAdmin() || isOwner(resource.data.userId);

      // Create: Authenticated user can create. Validate required fields, ownership (if userId provided), categories, total, etc.
      allow create: if isAuthenticated() &&
                       // userId is optional, but if provided, must match auth uid
                       (request.resource.data.userId == null || request.resource.data.userId == request.auth.uid) &&
                       hasRequiredFields(request.resource.data, ['date', 'truckNumber', 'categories', 'createdAt']) &&
                       isValidTimestamp(request.resource.data.date) &&
                       isString(request.resource.data.truckNumber) &&
                       isValidTicketCategories(request.resource.data.categories) &&
                       isValidTicketTotal(request.resource.data.categories, request.resource.data.total) && // Validate total against categories
                       // Validate optional fields if present
                       (request.resource.data.containsKey('imageUrls') ? isArray(request.resource.data.imageUrls) : true) &&
                       (request.resource.data.containsKey('imageCount') ? isValidImageCount(request.resource.data.imageUrls, request.resource.data.imageCount) : true) &&
                       (request.resource.data.containsKey('archiveStatus') ? isValidTicketArchiveStatus(request.resource.data.archiveStatus) : true) &&
                       isValidTimestamp(request.resource.data.createdAt);

      // Update: Admin or owner can update. Owner cannot change userId or archiveStatus. Validate fields.
      allow update: if isAdmin() ||
                       (isOwner(resource.data.userId) && // Check ownership based on existing doc
                        isNotChanging('userId') && // Owner cannot change userId
                        isNotChanging('archiveStatus') && // Owner cannot change archiveStatus
                        isNotChanging('createdAt') && // Cannot change createdAt
                        isValidTicketCategories(request.resource.data.categories) && // Validate fields on update
                        isValidTicketTotal(request.resource.data.categories, request.resource.data.total) &&
                        (request.resource.data.containsKey('imageUrls') ? isArray(request.resource.data.imageUrls) : true) &&
                        (request.resource.data.containsKey('imageCount') ? isValidImageCount(request.resource.data.imageUrls, request.resource.data.imageCount) : true) &&
                        isValidTimestamp(request.resource.data.updatedAt));

      // Delete: Only admins can delete.
      allow delete: if isAdmin();
    }

    // --- WizardState Collection (`wizardStates`) ---
    // Assuming document ID {userId} for simplicity as per schema example
    match /wizardStates/{userId} {
      // Read/Write: Only the owner can manage their wizard state.
      allow read, write: if isOwner(userId) &&
                           // Validate required fields on write (create/update)
                           (request.method == 'delete' || ( // Skip validation on delete
                             hasRequiredFields(request.resource.data, ['userId', 'currentStep', 'lastUpdated', 'expiresAt']) &&
                             request.resource.data.userId == userId && // Ensure userId in data matches docId/authId
                             isNumber(request.resource.data.currentStep) && request.resource.data.currentStep >= 1 && request.resource.data.currentStep <= 4 && // Example step range
                             isValidTimestamp(request.resource.data.lastUpdated) &&
                             isValidTimestamp(request.resource.data.expiresAt) &&
                             isTimestampInFuture(request.resource.data.expiresAt) &&
                             isTimestampNotTooFarInFuture(request.resource.data.expiresAt, 1) // Expires within 1 day
                           ));
    }

    // --- Exports Collection (`exports`) ---
    match /exports/{exportId} {
      // Read: Only admins can read export records.
      allow read: if isAdmin();

      // Create: Only admins can create. Validate required fields and enums.
      allow create: if isAdmin() &&
                       request.resource.data.userId == request.auth.uid && // Creator must be the admin making request
                       hasRequiredFields(request.resource.data, ['type', 'format', 'url', 'filename', 'createdAt', 'expiresAt', 'recordCount', 'status', 'userId']) &&
                       isValidExportType(request.resource.data.type) &&
                       isValidExportFormat(request.resource.data.format) &&
                       isString(request.resource.data.url) &&
                       isString(request.resource.data.filename) &&
                       isValidTimestamp(request.resource.data.createdAt) &&
                       isValidTimestamp(request.resource.data.expiresAt) && isTimestampInFuture(request.resource.data.expiresAt) &&
                       isNumber(request.resource.data.recordCount) && request.resource.data.recordCount >= 0 &&
                       isValidExportStatus(request.resource.data.status);

      // Update: Only admins can update. Validate fields.
      allow update: if isAdmin() &&
                       isValidExportStatus(request.resource.data.status) && // Can likely only update status/url/errorMessage
                       (request.resource.data.containsKey('errorMessage') ? isString(request.resource.data.errorMessage) : true);


      // Delete: Only admins can delete (e.g., cleanup).
      allow delete: if isAdmin();
    }

    // --- Archives Collection (`archives`) ---
    match /archives/{archiveId} {
      // Read: Only admins can read archive records.
      allow read: if isAdmin();

      // Create: Only admins can create. Validate required fields and enums.
      allow create: if isAdmin() &&
                       request.resource.data.archivedBy == request.auth.uid && // Archiver must be admin making request
                       hasRequiredFields(request.resource.data, ['type', 'originalId', 'title', 'date', 'archivedAt', 'archivedBy', 'status']) &&
                       isValidArchiveType(request.resource.data.type) &&
                       isString(request.resource.data.originalId) &&
                       isString(request.resource.data.title) &&
                       isValidTimestamp(request.resource.data.date) &&
                       isValidTimestamp(request.resource.data.archivedAt) &&
                       isValidArchiveStatus(request.resource.data.status) &&
                       (request.resource.data.containsKey('metadata') ? isMap(request.resource.data.metadata) : true);

      // Update: Only admins can update (e.g., change status to 'restored'). Validate fields.
      allow update: if isAdmin() &&
                       isValidArchiveStatus(request.resource.data.status); // Can likely only update status

      // Delete: Only admins can delete.
      allow delete: if isAdmin();
    }
  }
}
